# Domaine pointant (enregistrement DNS A) vers l'IP du VPS -> HTTPS automatique
# DOMAIN=jeu.mondomaine.fr
# Test rapide par IP, sans HTTPS :
DOMAIN=:80

# --- Réglages de la partie (lus par le serveur de jeu) ---
ROUND_SECONDS=150       # durée d'une manche (2 min 30)
FREEZE_SECONDS=10       # temps avant que le patient zéro se réveille (pour barricader)
FILL_TO=0               # remplit avec des bots jusqu'à N joueurs (0 = pas de bots)
